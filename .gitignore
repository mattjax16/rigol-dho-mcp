# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
wheels/
.eggs/
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# uv / pip
.uv/
pip-wheel-metadata/
*.whl
# NB: requirements.lock is intentionally TRACKED — the Dockerfile installs from
# it with --require-hashes. Don't add a *.lock rule here.

# Testing & coverage
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Type checking & linting
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# AI tooling. Ignores these directories wholesale, including machine-local
# state like .claude/settings.local.json (per-machine permission grants).
# Note this also excludes shared config such as .claude/settings.json and
# .claude/agents/ — if you ever want to commit project-wide agent or hook
# settings, this rule needs narrowing to .claude/settings.local.json.
.claude
.pi

# Logs
*.log

# Captures written by rigol-dho-cli. A scope screenshot shows whatever is on
# the bench at the time, so these stay out of the repo by default.
capture_*.png
capture_*.bin
shot_*.png

# Environment / secrets
.env
.env.*
!.env.example
