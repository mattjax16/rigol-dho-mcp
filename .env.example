# Rigol Oscilloscope Connection Settings
# Scope IP address or hostname (required - found under Utility > IO on the scope)
RIGOL_HOST=192.168.1.100

# SCPI socket port
RIGOL_PORT=5555

# I/O timeout, in seconds
RIGOL_TIMEOUT=10

# MCP Server Transport: stdio (local) or streamable-http (Docker/HTTP)
MCP_TRANSPORT=streamable-http

# HTTP bind address/port INSIDE the container (only used when
# MCP_TRANSPORT=streamable-http). Leave MCP_HOST at 0.0.0.0 — what actually
# controls exposure is MCP_BIND_ADDRESS below.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Host interface docker compose publishes the port on. Defaults to 127.0.0.1,
# so the endpoint is reachable only from the Docker host and is meant to sit
# behind a reverse proxy that adds authentication.
# WARNING: setting this to 0.0.0.0 puts an UNAUTHENTICATED endpoint on your
# LAN — anyone who can reach it can drive the scope and read its screen.
MCP_BIND_ADDRESS=127.0.0.1

# Container memory ceiling. A deep-memory get_waveform at 50M points expands
# to roughly 1.5-2 GB in Python floats, so don't lower this if you read deep
# memory — the container will be OOM-killed mid-read.
MCP_MEM_LIMIT=2g

# HTTP transport security (only relevant when MCP_TRANSPORT=streamable-http)
# Validates Origin/Host headers to prevent DNS rebinding attacks, and also
# configures CORS so browser-based clients (e.g. testing from a local
# desktop) can complete the preflight OPTIONS request. Default is "1"/on,
# which blocks all browser-origin requests until MCP_ALLOWED_ORIGINS is set.
MCP_ENABLE_DNS_REBINDING_PROTECTION=1

# Comma-separated list of allowed Origin header values, e.g.
# http://localhost:6274 for MCP Inspector. Only enforced when DNS rebinding
# protection is on above. Empty (default) blocks all browser-origin requests.
MCP_ALLOWED_ORIGINS=

# Comma-separated list of allowed Host header values. Only enforced when DNS
# rebinding protection is on above. Empty (default) blocks EVERY request, so
# with protection enabled you must set this to the exact host:port you connect
# to or the server will reject all MCP traffic with 421 Misdirected Request.
# Examples: "localhost:8000", "scope.home.lab:8000", "192.168.1.50:8000".
# (The container healthcheck hits /health, which is exempt from this check.)
MCP_ALLOWED_HOSTS=

# To allow ANY origin/host (e.g. quick local testing), set:
#   MCP_ENABLE_DNS_REBINDING_PROTECTION=0
#   MCP_ALLOWED_ORIGINS=*
# WARNING: this disables DNS-rebinding protection entirely — any site loaded
# in a browser on the same network could reach this server. Only do this on
# a trusted, isolated network.

# Optional: Enable raw SCPI escape hatch command (set to "1" to enable, "0" to disable)
# WARNING: Arbitrary SCPI can leave the scope in any state, so this is opt-in only
RIGOL_ENABLE_SCPI_RAW=0
